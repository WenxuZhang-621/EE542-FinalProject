# LLM (any OpenAI-compatible API; later our own vLLM server on the cloud GPU)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Empty = OpenAI. Examples: https://dashscope.aliyuncs.com/compatible-mode/v1 (Qwen),
# http://localhost:8000/v1 (vLLM through an SSH tunnel)
LLM_BASE_URL=
# schema (default) or object, for providers without json_schema structured output
LLM_JSON_MODE=schema

# Gmail: put the OAuth client file at ./credentials.json (git-ignored)
GMAIL_TEST_ACCOUNT=

# Storage
DB_PATH=data/po.sqlite
