# LLM (any OpenAI-compatible API; later our own vLLM server on the cloud GPU)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Empty = OpenAI. Examples: https://dashscope.aliyuncs.com/compatible-mode/v1 (Qwen),
# http://localhost:8001/v1 (vLLM through an SSH tunnel)
LLM_BASE_URL=
# schema (default) or object, for providers without json_schema structured output
LLM_JSON_MODE=schema
# Set to 1 for Qwen3 on vLLM to return extraction JSON without thinking output.
LLM_DISABLE_THINKING=0

# Gmail: put the OAuth client file at ./credentials.json (git-ignored)
# Legacy CLI account; adopted into Settings > Mailboxes on first use.
GMAIL_TEST_ACCOUNT=
# Optional paths, relative to the repository root (or absolute).
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# Optional Gmail search applied by default in the inbox sync dialog.
GMAIL_QUERY=

# Storage
DB_PATH=data/po.sqlite
